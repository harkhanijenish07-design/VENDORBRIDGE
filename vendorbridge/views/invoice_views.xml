<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Invoice Tree -->
    <record id="view_invoice_tree" model="ir.ui.view">
        <field name="name">vendorbridge.invoice.tree</field>
        <field name="model">vendorbridge.invoice</field>
        <field name="arch" type="xml">
            <tree decoration-success="state=='paid'"
                  decoration-info="state=='sent'"
                  decoration-danger="state=='cancelled'">
                <field name="name"/>
                <field name="vendor_id"/>
                <field name="purchase_order_id"/>
                <field name="invoice_date"/>
                <field name="due_date"/>
                <field name="gst_type"/>
                <field name="gst_rate"/>
                <field name="amount_untaxed" widget="float" options="{'precision': 2}"/>
                <field name="tax_amount" widget="float" options="{'precision': 2}"/>
                <field name="amount_total" widget="float" options="{'precision': 2}" sum="Total"/>
                <field name="email_sent" widget="boolean"/>
                <field name="state" widget="badge"
                       decoration-success="state=='paid'"
                       decoration-info="state in ('draft','sent')"
                       decoration-danger="state=='cancelled'"/>
            </tree>
        </field>
    </record>

    <!-- Invoice Form -->
    <record id="view_invoice_form" model="ir.ui.view">
        <field name="name">vendorbridge.invoice.form</field>
        <field name="model">vendorbridge.invoice</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_send_email" string="Send Email"
                            type="object" class="btn-primary"
                            invisible="state != 'draft'"
                            icon="fa-envelope"/>
                    <button name="action_mark_paid" string="Mark as Paid"
                            type="object" class="btn-success"
                            invisible="state != 'sent'"/>
                    <button name="action_cancel" string="Cancel"
                            type="object" class="btn-secondary"
                            invisible="state in ('paid','cancelled')"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,sent,paid"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Invoice Details">
                            <field name="purchase_order_id"/>
                            <field name="rfq_id"/>
                            <field name="vendor_id"/>
                            <field name="invoice_date"/>
                            <field name="due_date"/>
                            <field name="user_id"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                        <group string="GST Breakdown">
                            <field name="gst_type"/>
                            <field name="gst_rate"/>
                            <field name="amount_untaxed" widget="float" options="{'precision': 2}"/>
                            <field name="cgst_amount" widget="float" options="{'precision': 2}"
                                   invisible="gst_type != 'cgst_sgst'"/>
                            <field name="sgst_amount" widget="float" options="{'precision': 2}"
                                   invisible="gst_type != 'cgst_sgst'"/>
                            <field name="igst_amount" widget="float" options="{'precision': 2}"
                                   invisible="gst_type != 'igst'"/>
                            <field name="tax_amount" widget="float" options="{'precision': 2}"/>
                            <field name="amount_total" widget="float" options="{'precision': 2}"/>
                            <field name="email_sent"/>
                        </group>
                    </group>

                    <notebook>
                        <page string="Invoice Lines">
                            <field name="line_ids">
                                <tree editable="bottom">
                                    <field name="product_id"/>
                                    <field name="description"/>
                                    <field name="quantity"/>
                                    <field name="uom_id"/>
                                    <field name="price_unit"/>
                                    <field name="price_subtotal" sum="Total"/>
                                </tree>
                            </field>
                        </page>
                        <page string="Notes">
                            <field name="notes"/>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <!-- Invoice Search -->
    <record id="view_invoice_search" model="ir.ui.view">
        <field name="name">vendorbridge.invoice.search</field>
        <field name="model">vendorbridge.invoice</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="vendor_id"/>
                <field name="purchase_order_id"/>
                <filter string="Draft" name="draft" domain="[('state','=','draft')]"/>
                <filter string="Sent" name="sent" domain="[('state','=','sent')]"/>
                <filter string="Paid" name="paid" domain="[('state','=','paid')]"/>
                <filter string="Pending Payment" name="pending" domain="[('state','=','sent')]"/>
                <separator/>
                <filter string="CGST+SGST" name="cgst" domain="[('gst_type','=','cgst_sgst')]"/>
                <filter string="IGST" name="igst" domain="[('gst_type','=','igst')]"/>
                <separator/>
                <filter string="This Month" name="this_month"
                        domain="[('invoice_date','&gt;=', (context_today() - relativedelta(day=1)).strftime('%%Y-%%m-%%d'))]"/>
                <filter string="This Year" name="this_year"
                        domain="[('invoice_date','&gt;=', (context_today() - relativedelta(month=1, day=1)).strftime('%%Y-%%m-%%d'))]"/>
                <separator/>
                <group expand="0" string="Group By">
                    <filter string="Status" name="group_state" context="{'group_by': 'state'}"/>
                    <filter string="Vendor" name="group_vendor" context="{'group_by': 'vendor_id'}"/>
                    <filter string="GST Type" name="group_gst" context="{'group_by': 'gst_type'}"/>
                    <filter string="Month" name="group_month" context="{'group_by': 'invoice_date:month'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Invoice Action -->
    <record id="action_invoice_list" model="ir.actions.act_window">
        <field name="name">Invoices</field>
        <field name="res_model">vendorbridge.invoice</field>
        <field name="view_mode">tree,form</field>
        <field name="search_view_id" ref="view_invoice_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No invoices generated yet
            </p>
            <p>Invoices are auto-generated when purchase orders are confirmed.</p>
        </field>
    </record>
</odoo>
