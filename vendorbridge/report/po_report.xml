<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- PO Report Action -->
    <record id="action_report_po" model="ir.actions.report">
        <field name="name">VendorBridge Purchase Order</field>
        <field name="model">vendorbridge.purchaseorder</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">vendorbridge.report_po_document</field>
        <field name="report_file">vendorbridge.report_po_document</field>
        <field name="print_report_name">'Purchase Order - %s' % (object.name)</field>
        <field name="binding_model_id" ref="model_vendorbridge_purchaseorder"/>
        <field name="binding_type">report</field>
    </record>

    <!-- PO QWeb Template -->
    <template id="report_po_document">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-call="web.external_layout">
                    <div class="page">
                        <h2>
                            <span>Purchase Order</span>
                            <span t-field="doc.name"/>
                        </h2>

                        <div class="row mt-4 mb-4">
                            <div class="col-6">
                                <strong>Vendor:</strong><br/>
                                <span t-field="doc.vendor_id.name"/><br/>
                                <span t-field="doc.vendor_id.street"/><br/>
                                <t t-if="doc.vendor_id.city">
                                    <span t-field="doc.vendor_id.city"/>,
                                </t>
                                <span t-field="doc.vendor_id.state_id.name"/><br/>
                                <t t-if="doc.vendor_id.gst_number">
                                    <strong>GSTIN:</strong> <span t-field="doc.vendor_id.gst_number"/><br/>
                                </t>
                            </div>
                            <div class="col-6 text-end">
                                <strong>Order Date:</strong> <span t-field="doc.date_order"/><br/>
                                <strong>Planned Date:</strong> <span t-field="doc.date_planned"/><br/>
                                <strong>RFQ Reference:</strong> <span t-field="doc.rfq_id.name"/><br/>
                                <strong>Quotation Ref:</strong> <span t-field="doc.quotation_id.name"/><br/>
                                <strong>Status:</strong> <span t-field="doc.state"/>
                            </div>
                        </div>

                        <table class="table table-sm table-bordered mt-4">
                            <thead>
                                <tr>
                                    <th class="text-start">Description</th>
                                    <th class="text-end">Quantity</th>
                                    <th class="text-end">Unit Price (₹)</th>
                                    <th class="text-end">Subtotal (₹)</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-foreach="doc.line_ids" t-as="line">
                                    <tr>
                                        <td><span t-field="line.description"/></td>
                                        <td class="text-end"><span t-field="line.quantity"/></td>
                                        <td class="text-end"><span t-field="line.price_unit" t-options='{"widget": "float", "precision": 2}'/></td>
                                        <td class="text-end"><span t-field="line.price_subtotal" t-options='{"widget": "float", "precision": 2}'/></td>
                                    </tr>
                                </t>
                            </tbody>
                        </table>

                        <div class="row mt-4">
                            <div class="col-6"/>
                            <div class="col-6">
                                <table class="table table-sm">
                                    <tr class="border-top">
                                        <td><strong>Total Amount:</strong></td>
                                        <td class="text-end"><strong>₹ <span t-field="doc.amount_total" t-options='{"widget": "float", "precision": 2}'/></strong></td>
                                    </tr>
                                </table>
                            </div>
                        </div>

                        <t t-if="doc.notes">
                            <div class="mt-4">
                                <strong>Notes:</strong><br/>
                                <span t-field="doc.notes"/>
                            </div>
                        </t>
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>
