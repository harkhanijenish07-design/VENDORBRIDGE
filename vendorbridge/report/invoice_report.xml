<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Invoice Report Action -->
    <record id="action_report_invoice" model="ir.actions.report">
        <field name="name">VendorBridge Invoice</field>
        <field name="model">vendorbridge.invoice</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">vendorbridge.report_invoice_document</field>
        <field name="report_file">vendorbridge.report_invoice_document</field>
        <field name="print_report_name">'Invoice - %s' % (object.name)</field>
        <field name="binding_model_id" ref="model_vendorbridge_invoice"/>
        <field name="binding_type">report</field>
    </record>

    <!-- Invoice QWeb Template -->
    <template id="report_invoice_document">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-call="web.external_layout">
                    <div class="page">
                        <h2>
                            <span>Invoice</span>
                            <span t-field="doc.name"/>
                        </h2>

                        <div class="row mt-4 mb-4">
                            <div class="col-6">
                                <strong>Vendor:</strong><br/>
                                <span t-field="doc.vendor_id.name"/><br/>
                                <span t-field="doc.vendor_id.street"/><br/>
                                <t t-if="doc.vendor_id.city">
                                    <span t-field="doc.vendor_id.city"/>,
                                </t>
                                <span t-field="doc.vendor_id.state_id.name"/><br/>
                                <t t-if="doc.vendor_id.gst_number">
                                    <strong>GSTIN:</strong> <span t-field="doc.vendor_id.gst_number"/><br/>
                                </t>
                            </div>
                            <div class="col-6 text-end">
                                <strong>Invoice Date:</strong> <span t-field="doc.invoice_date"/><br/>
                                <strong>Due Date:</strong> <span t-field="doc.due_date"/><br/>
                                <strong>PO Reference:</strong> <span t-field="doc.purchase_order_id.name"/><br/>
                                <strong>RFQ Reference:</strong> <span t-field="doc.rfq_id.name"/><br/>
                                <strong>Status:</strong> <span t-field="doc.state"/>
                            </div>
                        </div>

                        <table class="table table-sm table-bordered mt-4">
                            <thead>
                                <tr>
                                    <th class="text-start">Description</th>
                                    <th class="text-end">Quantity</th>
                                    <th class="text-end">Unit Price (₹)</th>
                                    <th class="text-end">Subtotal (₹)</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-foreach="doc.line_ids" t-as="line">
                                    <tr>
                                        <td><span t-field="line.description"/></td>
                                        <td class="text-end"><span t-field="line.quantity"/></td>
                                        <td class="text-end"><span t-field="line.price_unit" t-options='{"widget": "float", "precision": 2}'/></td>
                                        <td class="text-end"><span t-field="line.price_subtotal" t-options='{"widget": "float", "precision": 2}'/></td>
                                    </tr>
                                </t>
                            </tbody>
                        </table>

                        <!-- Totals Section -->
                        <div class="row mt-4">
                            <div class="col-6"/>
                            <div class="col-6">
                                <table class="table table-sm">
                                    <tr>
                                        <td><strong>Untaxed Amount:</strong></td>
                                        <td class="text-end">₹ <span t-field="doc.amount_untaxed" t-options='{"widget": "float", "precision": 2}'/></td>
                                    </tr>
                                    <tr t-if="doc.gst_type == 'cgst_sgst'">
                                        <td><strong>CGST (<span t-esc="int(int(doc.gst_rate)/2)"/>%):</strong></td>
                                        <td class="text-end">₹ <span t-field="doc.cgst_amount" t-options='{"widget": "float", "precision": 2}'/></td>
                                    </tr>
                                    <tr t-if="doc.gst_type == 'cgst_sgst'">
                                        <td><strong>SGST (<span t-esc="int(int(doc.gst_rate)/2)"/>%):</strong></td>
                                        <td class="text-end">₹ <span t-field="doc.sgst_amount" t-options='{"widget": "float", "precision": 2}'/></td>
                                    </tr>
                                    <tr t-if="doc.gst_type == 'igst'">
                                        <td><strong>IGST (<span t-field="doc.gst_rate"/>):</strong></td>
                                        <td class="text-end">₹ <span t-field="doc.igst_amount" t-options='{"widget": "float", "precision": 2}'/></td>
                                    </tr>
                                    <tr class="border-top">
                                        <td><strong>Total Amount:</strong></td>
                                        <td class="text-end"><strong>₹ <span t-field="doc.amount_total" t-options='{"widget": "float", "precision": 2}'/></strong></td>
                                    </tr>
                                </table>
                            </div>
                        </div>

                        <t t-if="doc.notes">
                            <div class="mt-4">
                                <strong>Notes:</strong><br/>
                                <span t-field="doc.notes"/>
                            </div>
                        </t>
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>
