<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- ============================================================ -->
        <!-- Settings: Approval Thresholds -->
        <!-- ============================================================ -->
        <record id="vendorbridge_threshold_1" model="ir.config_parameter">
            <field name="key">vendorbridge.threshold_1</field>
            <field name="value">50000</field>
        </record>
        <record id="vendorbridge_threshold_2" model="ir.config_parameter">
            <field name="key">vendorbridge.threshold_2</field>
            <field name="value">200000</field>
        </record>
        <record id="vendorbridge_default_gst" model="ir.config_parameter">
            <field name="key">vendorbridge.default_gst</field>
            <field name="value">18</field>
        </record>

        <!-- ============================================================ -->
        <!-- Vendor Categories -->
        <!-- ============================================================ -->
        <record id="vendor_category_it_hardware" model="vendorbridge.vendor.category">
            <field name="name">IT Hardware</field>
            <field name="description">Computers, servers, networking equipment, peripherals</field>
        </record>

        <record id="vendor_category_furniture" model="vendorbridge.vendor.category">
            <field name="name">Furniture</field>
            <field name="description">Office furniture, desks, chairs, cabinets</field>
        </record>

        <record id="vendor_category_stationery" model="vendorbridge.vendor.category">
            <field name="name">Stationery</field>
            <field name="description">Office supplies, paper, pens, printing materials</field>
        </record>

        <!-- ============================================================ -->
        <!-- Company State (Maharashtra - for GST intra/inter state logic) -->
        <!-- ============================================================ -->
        <record id="base.main_company" model="res.company">
            <field name="state_id" ref="base.state_in_mh"/>
            <field name="country_id" ref="base.in"/>
        </record>

