            <field name="state">closed</field>
            <field name="vendor_ids" eval="[(6, 0, [ref('vendor_infra_supplies'), ref('vendor_packing_transport'), ref('vendor_furnico')])]"/>
        </record>

        <!-- RFQ 1 Lines -->
        <record id="demo_rfq_1_line_1" model="vendorbridge.rfq.line">
            <field name="rfq_id" ref="demo_rfq_1"/>
            <field name="description">Executive Office Desk (150x75cm)</field>
            <field name="quantity">5</field>
        </record>

        <record id="demo_rfq_1_line_2" model="vendorbridge.rfq.line">
